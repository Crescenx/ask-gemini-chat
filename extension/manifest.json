{
  "manifest_version": 3,
  "name": "Gemini MCP 登录助手",
  "version": "0.2.0",
  "description": "自动同步当前浏览器的 Gemini 登录状态到本机 MCP，并显示连接状态。",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini MCP 登录状态"
  },
  "key": ""
}
