{
  "name": "ask-gemini-chat",
  "version": "0.1.0",
  "description": "Unofficial local MCP server for Gemini web chat with file uploads and durable request recovery",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.py",
    "src/api/*.ts",
    "!src/**/*.test.mjs",
    "requirements-http.txt",
    "README.md",
    "BOUNDARIES.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/*.mjs",
    "scripts/server.ts",
    "INSTALL.md",
    "AGENTS.md",
    "!scripts/*.test.mjs"
  ],
  "scripts": {
    "start": "node scripts/server.ts",
    "auth": "node scripts/auth.mjs",
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.mjs scripts/*.test.mjs test/api/*.test.ts",
    "prepack": "npm run check && npm test",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "mime-types": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "private": true
}
